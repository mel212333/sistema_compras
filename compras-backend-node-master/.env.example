PORT=4000

# Produccion/demo: usar una URL de PostgreSQL (Neon, Supabase, Render, etc.)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DB_SSL=true

# Local: usar estas variables si no definis DATABASE_URL.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=compras
DB_USER=postgres
DB_PASS=postgres

JWT_SECRET=cambiar-por-un-secreto-largo
JWT_EXPIRES=1d

# Dominio del frontend. Para varios dominios, separar por coma.
CORS_ORIGIN=http://localhost:5173

# Solo demo/inicializacion. Desactivar en produccion.
DB_SYNC=false
DB_SYNC_ALTER=false
DEMO_SEED=false
DEMO_PASSWORD=demo1234
